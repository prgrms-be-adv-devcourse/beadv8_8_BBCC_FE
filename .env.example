# 복사해서 .env.local로 쓴다
VITE_API_BASE_URL=http://localhost:8080
# 토스페이먼츠 테스트 클라이언트 키 (결제 담당에게 받기)
VITE_TOSS_CLIENT_KEY=
# 카카오 REST API 키 · Redirect URI (백엔드 KAKAO_REDIRECT_URI와 같아야 함)
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback
# 백엔드에 없는 API(상품 · 추천 · 정산) 목 응답. false면 끈다
VITE_USE_MOCK=true
# 시연 역할 전환(개발용 토큰, 백엔드 local 프로필 전용). 개발 토큰이 없는 서버에 배포하면 false
VITE_DEMO_ROLE_SWITCH=true
# 시연 도구(시연 막대 표시 · 시연 콘솔 · API 흐름 · 시연용 문구). 비우면 VITE_DEMO_ROLE_SWITCH를 따른다
VITE_DEMO_TOOLS=
