# 복사해서 .env.local로 쓴다
VITE_API_BASE_URL=http://localhost:8080
# 토스페이먼츠 테스트 클라이언트 키 (결제 담당에게 받기)
VITE_TOSS_CLIENT_KEY=
# 카카오 REST API 키 · Redirect URI (백엔드 KAKAO_REDIRECT_URI와 같아야 함)
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback
# 목 데이터 · 시연 기능(역할 전환 · 시연 콘솔 · API 흐름)을 켜고 끈다 (false면 끔, 없으면 켬)
VITE_USE_MOCK=true
VITE_DEMO_ROLE_SWITCH=true

# 포트원 V2 상점 ID · 본인인증 채널 키
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=
# Firebase 웹 앱 설정 · 웹 푸시 VAPID 공개 키 (Firebase 콘솔 → 프로젝트 설정 → 일반 · 클라우드 메시징, 알림 담당에게)
# 하나라도 비우면 웹 푸시(알림 받기 버튼 포함)를 끈다
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
# Microsoft Clarity 프로젝트 ID (히트맵 · 세션 녹화). 로컬 · 개발에서는 비워 둔다 (데이터가 섞인다)
VITE_CLARITY_PROJECT_ID=
